{"transcript":"im.botˈti.ta","exists":true,"definitions":["Capo di abbigliamento o oggetto imbottito per renderlo più morbido o caldo.","Giacca o cappotto con imbottitura interna.","Coperta o trapunta imbottita."],"examples":["Indossava un'imbottita pesante.","L'imbottita proteggeva dal freddo.","Ha comprato un'imbottita nuova."],"lemma":"imbottito","lemmaPos":"adjective","synonyms":["giacca a vento","piumino","trapunta"],"number":"singular","pluralForm":"le imbottite","gender":"feminine","source":"imbottita","frequency":2}