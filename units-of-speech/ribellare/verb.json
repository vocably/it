{"transcript":"ri.belˈla.re","exists":true,"definitions":["Sollevarsi contro un'autorità o un potere costituito.","Rifiutarsi di obbedire o di sottomettersi.","Manifestare opposizione o dissenso."],"examples":["Il popolo decise di ribellare.","Non si può ribellare a tutte le regole.","Si ribellò alla sua sorte."],"lemma":"ribellare","lemmaPos":"verb","synonyms":["insorgere","rivoltarsi","opporsi","disobbedire"],"number":"singular","tense":"present","pastTenses":"ribellò (past simple), ha ribellato (present perfect)","source":"ribellare","frequency":4}